# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zakazi_termin"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@zakazi-termin.rs"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Zakazi Termin"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Europe/Belgrade"
NEXT_PUBLIC_DEFAULT_LOCALE="sr"

# Better Stack Logging
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=""

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cron Jobs
CRON_SECRET=""

# Upstash Redis (for distributed rate limiting)
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Trial Period (in minutes, default 43200 = 30 days)
TRIAL_PERIOD_MINUTES=43200


# AWS S3 Configuration
# Get these from: https://console.aws.amazon.com/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_WEB_PRESENCE=

# AI Agent
# Shared secret for /api/agent/* internal tool endpoints
AGENT_API_SECRET=""

# Anthropic (Claude)
ANTHROPIC_API_KEY=""

# Laminar (agent evals dashboard, optional)
# Get from: https://www.lmnr.ai/
LMNR_PROJECT_API_KEY=""

# Messaging AI feature flag
# Set to "true" to enable the AI-powered WhatsApp/Viber messaging feature
# (settings page, tRPC router, webhooks, agent). Disabled by default.
NEXT_PUBLIC_MESSAGING_AI_ENABLED="false"

# WhatsApp (Meta Cloud API)
# Shared webhook verify token used for the GET handshake across all tenants.
# Each salon pastes the same string into their own Meta app's "Verify token" field.
# Per-salon phone_number_id + access_token (encrypted) are stored in the
# MessagingChannel table — salon owners add them via /dashboard/settings/messaging.
WHATSAPP_WEBHOOK_SECRET=""

# Viber bot credentials are stored per-channel (encrypted) in the MessagingChannel
# table — salon owners add them via /dashboard/settings/messaging.

# Messaging credential encryption key (AES-256-GCM, 32 bytes hex-encoded).
# Generate with: openssl rand -hex 32
MESSAGING_TOKEN_ENC_KEY=""
