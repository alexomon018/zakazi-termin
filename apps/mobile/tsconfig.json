{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@salonko/trpc": ["../../packages/trpc/src"],
      "@salonko/trpc/*": ["../../packages/trpc/src/*"],
      "@salonko/prisma": ["../../packages/prisma/src"],
      "@salonko/prisma/*": ["../../packages/prisma/src/*"],
      "@salonko/config": ["../../packages/config/src"],
      "@salonko/config/*": ["../../packages/config/src/*"],
      "@salonko/scheduling": ["../../packages/scheduling/src"],
      "@salonko/scheduling/*": ["../../packages/scheduling/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "extends": "expo/tsconfig.base"
}
