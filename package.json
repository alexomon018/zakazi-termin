{
  "name": "salonko",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "yarn workspace @salonko/web dev",
    "dev:mobile": "yarn workspace @salonko/mobile dev",
    "prod:web": "yarn workspace @salonko/web build && yarn workspace @salonko/web start",
    "prod:mobile": "yarn workspace @salonko/mobile build && yarn workspace @salonko/mobile start",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "tsc": "tsc -b && tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck": "turbo run typecheck",
    "migrate": "node ./scripts/migrate-preview.mjs",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "yarn workspace @salonko/prisma db:studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "yarn workspace @salonko/web test:e2e",
    "test:e2e:ui": "yarn workspace @salonko/web test:e2e:ui",
    "test:e2e:ci": "yarn workspace @salonko/web test:e2e:ci",
    "test:e2e:mobile": "bash scripts/e2e-mobile.sh",
    "maestro:coverage": "node scripts/validate-maestro-coverage.mjs",
    "maestro:smoke": "bash scripts/maestro-smoke.sh",
    "maestro:test": "bash scripts/maestro-test-all.sh",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d",
    "test:db:stop": "docker compose -f docker-compose.test.yml down",
    "prepare": "husky"
  },
  "resolutions": {
    "react-hook-form": "^7.68.0",
    "next-auth": "^4.24.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "yaml": "^2.7.0"
  }
}
