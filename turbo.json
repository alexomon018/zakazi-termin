{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [".env", ".env.development", ".env.production"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
