# OAuth client ID — generated by: yarn workspace @salonko/prisma ts-node src/seed-oauth-client.ts
# Must also be set as EAS Secret for cloud builds (eas secret:create)
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# API URL — auto-detected from Expo debuggerHost in development.
# Set explicitly for production/staging builds (must be https).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Sentry DSN — enables error reporting in production builds.
# Must also be set as EAS Secret for cloud builds.
EXPO_PUBLIC_SENTRY_DSN=
