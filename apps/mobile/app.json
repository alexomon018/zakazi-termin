{
  "expo": {
    "name": "Salonko",
    "slug": "salonko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "salonko",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#BA3678"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zakazitermin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.zakazitermin.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/81fe5488-5e98-4892-ac99-ea5bfb736344"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81fe5488-5e98-4892-ac99-ea5bfb736344"
      }
    },
    "owner": "alexomon018"
  }
}
